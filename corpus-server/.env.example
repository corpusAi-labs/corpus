NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

MONGO_URI=

# JWT secrets — at least 32 random characters (enforced in production).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_SECRET=
REFRESH_SECRET=

# ── Encryption at rest ────────────────────────────────────────────────
# Where the master key (KEK) lives: "local" (env var below) or "gcp-kms".
KEY_PROVIDER=local
# Local KEK: 32 bytes, base64. NEVER store it in the database. Back it up —
# if it is lost, every user's data is unrecoverable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# During KEK rotation: previous keys, comma-separated (see docs/SECURITY_ARCHITECTURE.md)
DATA_ENCRYPTION_KEYS_RETIRED=
# For KEY_PROVIDER=gcp-kms (also: npm i @google-cloud/kms)
GCP_KMS_KEY_NAME=
DEK_CACHE_TTL_SECONDS=300

# ── Privacy & retention ───────────────────────────────────────────────
AUDIT_RETENTION_DAYS=30
TRASH_RETENTION_DAYS=30
MEDIA_URL_TTL_SECONDS=3600

# ── Redis ─────────────────────────────────────────────────────────────
# Shared rate limits, per-account login lockout, OTPs and instant token
# revocation across all server instances. Use rediss:// for TLS (Upstash, Render
# Key Value, ElastiCache). Without it, each instance falls back to memory.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=corpus:

# ── Files & background jobs ───────────────────────────────────────────
# Encrypted file blobs: "local" (STORAGE_DIR) or "cloudinary" (default when Cloudinary is configured).
# Note: Cloudinary's free plan caps raw files at 10 MB.
STORAGE_DRIVER=
STORAGE_DIR=./storage
QUEUE_CONCURRENCY=2
PDF_WORKER_TIMEOUT_MS=60000
PDF_WORKER_MEMORY_MB=512

# Semantic search engine: auto (Atlas $vectorSearch, else in-app cosine), atlas, or app
VECTOR_SEARCH_BACKEND=auto

# ── AI data routing ───────────────────────────────────────────────────
# Providers allowed to process PRIVATE content (notes, images, PDFs). List only
# providers you use under zero-retention / no-training terms.
AI_PRIVATE_PROVIDERS=groq,gemini

# ── Network ───────────────────────────────────────────────────────────
# Number of proxies in front of the app (1 on Render/Railway/Heroku) — needed for correct client IPs / rate limits
TRUST_PROXY=0
# Extra allowed browser origins and Chrome extension IDs (comma-separated)
CORS_ORIGINS=
EXTENSION_IDS=

# ── Third parties ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use a PAID-tier Gemini key: free-tier API content may be used by Google to improve its products.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Corpus" <no-reply@corpus.app>
